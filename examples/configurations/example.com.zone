; Zona fictícia de documentação. example.com não é um domínio deste portfólio.
$TTL 3600
@       IN SOA  ns1.example.com. hostmaster.example.com. (
                2026041201 ; serial
                7200       ; refresh
                3600       ; retry
                1209600    ; expire
                3600 )     ; minimum
        IN NS   ns1.example.com.
ns1     IN A    192.0.2.53
app-01  IN A    192.0.2.10
db      IN A    192.0.2.20
